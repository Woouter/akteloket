# Modus: demo (standaard) of production
APP_MODE=demo

# Publieke basis-URL (voor links in e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database: zonder DATABASE_URL wordt de ingebedde PGlite-database in .data/ gebruikt
# DATABASE_URL=postgres://user:pass@host:5432/akteloket

# Versleuteling van documenten — VERPLICHT in productie (32 bytes, base64)
# Genereren: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY=

# AI-extractie van koopovereenkomst en bankinstructie (optioneel)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Kadaster: zonder URL wordt de demo-koppeling gebruikt
# KADASTER_PROVIDER=http
# KADASTER_API_URL=https://jouw-kadaster-api.example
# KADASTER_API_KEY=

# E-mail (zonder SMTP_URL worden e-mails alleen gelogd)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Akteloket <hallo@akte-loket.nl>"

# Beveiliging van /api/cron (termijnbewaking, herinneringen)
# CRON_SECRET=

# Medewerkers in productie (komma-gescheiden e-mailadressen)
# STAFF_NOTARY_EMAILS=notaris@kantoor.nl
# STAFF_OPS_EMAILS=team@akte-loket.nl

# Aangesloten notaris
# NOTARY_OFFICE_NAME=Notariskantoor Van Dam
# NOTARY_NAME=mr. L.M. (Lotte) van Dam
# NOTARY_SHORT=mr. L.M. van Dam
# NOTARY_CITY=Amersfoort
# NOTARY_ADDRESS=Stationsplein 8, 3818 LE Amersfoort
