# =============================================================================
#  Akteloket — instellingen
#
#  Kopieer dit bestand naar .env.local (dat bestand gaat NOOIT naar GitHub):
#      cp .env.example .env.local
#  Vul blok 1 in en draai:
#      npm install
#      npm run setup
#  Het setup-script maakt de databases, opslag, e-maildomein, Vercel-projecten,
#  omgevingsvariabelen en domeinen zelf aan. Zie docs/DEPLOY.md.
#
#  Lokaal ontwikkelen (npm run dev) kan zonder iets in te vullen: dan draait de
#  demo met een ingebouwde database.
# =============================================================================


# --- 1. VUL IN ---------------------------------------------------------------

# Supabase → Account → Access Tokens → "Generate new token"
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Vercel → Account Settings → Tokens → "Create" (scope: je account of team)
# https://vercel.com/account/tokens
VERCEL_TOKEN=

# Resend → API Keys → "Create API key" met permissie "Full access"
# (het script maakt zelf een aparte verzendsleutel voor de app aan)
# https://resend.com/api-keys
RESEND_API_KEY=

# Je domein. De demo komt op demo.<domein>.
DOMAIN=akte-loket.nl


# --- 2. AANBEVOLEN -----------------------------------------------------------

# Wie mag inloggen als notaris / in de beheeromgeving (komma-gescheiden e-mailadressen).
# Zonder deze adressen kan niemand inloggen in die omgevingen.
STAFF_NOTARY_EMAILS=
STAFF_OPS_EMAILS=

# AI-scanner voor koopovereenkomst en bankinstructie (leest ook scans en foto's).
# Zonder sleutel gebruikt de app de regelgebaseerde scanner.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# --- 3. OPTIONEEL (alleen invullen als het nodig is) -------------------------

# Alleen nodig als je meerdere Supabase-organisaties hebt (het script noemt de keuzes).
SUPABASE_ORG_SLUG=

# Alleen nodig als je Vercel-token bij een team hoort (Team Settings → General → Team ID).
VERCEL_TEAM_ID=

# GitHub-repository die Vercel deployt.
GITHUB_REPO=Woouter/akteloket

# Ook de AI-scanner aanzetten in de publieke demo (kost API-tegoed per upload): ja/nee
DEMO_AI=nee

# Kadaster: je eigen Kadaster-API. Zonder URL gebruikt de app de demo-koppeling.
KADASTER_API_URL=
KADASTER_API_KEY=

# De aangesloten notaris (komt in de akten en op de website).
NOTARY_OFFICE_NAME=
NOTARY_NAME=
NOTARY_SHORT=
NOTARY_CITY=
NOTARY_ADDRESS=

# Afzender van e-mails. Standaard: Akteloket <hallo@DOMAIN>
MAIL_FROM=
MAIL_REPLY_TO=

# Alleen nodig als een Supabase-project al bestond en .akteloket-setup.json kwijt is:
# zet het databasewachtwoord opnieuw in Supabase en vul het hier in.
SUPABASE_DB_PASSWORD_PROD=
SUPABASE_DB_PASSWORD_DEMO=


# --- 4. APP-INSTELLINGEN (zet het setup-script zelf in Vercel) ---------------
#
# Deze hoef je lokaal niet in te vullen. Ter referentie, of voor hosting zonder Vercel
# (Docker, eigen server):
#
# APP_MODE=demo                          demo | production
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# DATABASE_URL=postgres://…              zonder: ingebouwde database in .data/
# ENCRYPTION_KEY=                        32 bytes base64, verplicht in productie
#                                        node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRON_SECRET=                           beveiligt /api/cron
# SUPABASE_URL=                          upload-inbox voor bestanden groter dan 4 MB
# SUPABASE_SERVICE_ROLE_KEY=
# SMTP_URL=smtps://user:pass@host:465    alternatief voor Resend
# DATABASE_CA_CERT=                      PEM, voor volledige TLS-verificatie van de database
